APP_ENV=local
LOG_LEVEL=INFO
API_AUTH_TOKEN=replace_with_a_long_random_token
RATE_LIMIT_PER_MINUTE=120
MAX_AUDIO_BYTES=10485760
ALLOWED_ORIGINS=

# Local default is a SQLite file. Production can use a managed PostgreSQL
# database; the adapter initializes migrations/constraints at startup.
DATABASE_URL=sqlite:///./data/realestate_agent.db
DATABASE_MIGRATION_URL=sqlite:///./data/realestate_agent.db
DATABASE_AUTO_MIGRATE=false
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
TRANSCRIPT_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=30
MONITORING_RETENTION_DAYS=90
# PostgreSQL backup utilities use external libpq service files; keep password
# material in a protected PGPASSFILE/secret manager, never in this file.
PGSERVICE=
PGSERVICEFILE=
PGPASSFILE=
RESTORE_PGSERVICE=
RESTORE_DATABASE_NAME=
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=

# Local default is an in-process TF-IDF index. Production deployments should
# point this at the approved hosted vector-store adapter.
VECTOR_DATABASE_URL=local://tfidf-vector-store

# Provider-backed voice path used by /voice/turn and the notebook microphone client.
STT_PROVIDER=deepgram
TTS_PROVIDER=fish_audio
LLM_PROVIDER=local-adapter
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b
DEEPGRAM_API_KEY=replace_me
DEEPGRAM_MODEL=nova-3
FISH_AUDIO_API_KEY=replace_me
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=

# Required for real Google Calendar and Gmail side effects.
GOOGLE_CALENDAR_CREDENTIALS_JSON=replace_me
GMAIL_CREDENTIALS_JSON=replace_me
GMAIL_OAUTH_CLIENT_SECRETS_JSON=replace_me
CALENDAR_PROVIDER=local
EMAIL_PROVIDER=local
GOOGLE_CALENDAR_ID=primary
GMAIL_SENDER=me

REQUIRE_LIVE_PROVIDERS_IN_PRODUCTION=true
