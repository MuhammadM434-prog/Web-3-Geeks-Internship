APP_ENV=production
LOG_LEVEL=INFO

# Real, working by default (a SQLite file). Point at Postgres for production
# and implement the psycopg branch in app/database.py::DatabaseAdapter._connect.
DATABASE_URL=sqlite:///./data/realestate_agent.db

# Real, working by default (an in-process TF-IDF index built at startup).
# Point at a hosted vector DB and swap VectorDatabaseAdapter's internals for
# production-scale semantic recall.
VECTOR_DATABASE_URL=local://tfidf-vector-store

# These two are genuinely not implemented in this build (no STT/TTS audio
# path exists yet -- the service accepts already-transcribed text turns).
# Wire a real provider here before connecting a live telephony/voice layer.
STT_PROVIDER=not-yet-implemented
TTS_PROVIDER=not-yet-implemented

# Required before booking against a real Google Calendar / sending real
# Gmail notifications -- currently the calendar/email adapters are fully
# functional but entirely local (real conflict detection, real idempotency,
# real persistence), not connected to Google's APIs.
GOOGLE_CALENDAR_CREDENTIALS_JSON=replace_me
GMAIL_CREDENTIALS_JSON=replace_me

REQUIRE_LIVE_PROVIDERS_IN_PRODUCTION=true
