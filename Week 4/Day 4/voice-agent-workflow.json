{
  "name": "Real Estate Voice Agent - Call to CRM",
  "nodes": [
    {
      "id": "webhook-incoming-call",
      "name": "Incoming Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1120,
        300
      ],
      "webhookId": "voice-agent-call-completed",
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-agent/call-completed",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "http-intent-classification",
      "name": "Intent Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -880,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://internal-api.yourcompany.com/agent/intent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"call_id\": $json.call_id, \"transcript\": $json.transcript } }}",
        "options": {
          "timeout": 8000
        }
      }
    },
    {
      "id": "http-property-match",
      "name": "Property Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://internal-api.yourcompany.com/agent/property-match",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"call_id\": $json.call_id, \"intent\": $json.intent, \"preferences\": $json.preferences } }}",
        "options": {
          "timeout": 8000
        }
      }
    },
    {
      "id": "if-property-found",
      "name": "Property Match Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -400,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-property-id",
              "leftValue": "={{ $json.property_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "gcal-create-event",
      "name": "Google Calendar - Book Visit",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -160,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.employee_calendar_id }}"
        },
        "start": "={{ $json.start_time }}",
        "end": "={{ $json.end_time }}",
        "additionalFields": {
          "summary": "={{ $json.property_name + ' visit - ' + $json.client_name }}",
          "description": "=Client: {{ $json.client_name }}\nPhone: {{ $json.client_phone }}\nNotes: {{ $json.requirements }}",
          "useDefaultReminders": true
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "GCAL_CRED_ID",
          "name": "Google Calendar - Agency Account"
        }
      }
    },
    {
      "id": "gmail-notify-employee",
      "name": "Gmail - Notify Employee",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        80,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.employee_email }}",
        "subject": "=New visit: {{ $json.property_name }} \u2014 {{ $json.start_time }}",
        "emailType": "text",
        "message": "=Hi {{ $json.employee_name }},\n\nA property visit has been booked on your calendar.\n\nProperty: {{ $json.property_name }} ({{ $json.property_id }})\nDate/Time: {{ $json.start_time }} - {{ $json.end_time }}\nClient: {{ $json.client_name }}\nClient phone: {{ $json.client_phone }}\nClient requirements: {{ $json.requirements }}\n\nCalendar event: {{ $json.calendar_event_id }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CRED_ID",
          "name": "Gmail - Agency Account"
        }
      }
    },
    {
      "id": "postgres-crm-update",
      "name": "Postgres - CRM Update",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO appointment_history (appointment_id, call_id, client_name, client_phone, employee_id, property_id, action, detail, occurred_at)\nVALUES ($1, $2, $3, $4, $5, $6, 'booked', $7, now())\nON CONFLICT (appointment_id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [$json.appointment_id, $json.call_id, $json.client_name, $json.client_phone, $json.employee_id, $json.property_id, $json.requirements] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "CRM Postgres"
        }
      }
    },
    {
      "id": "respond-success",
      "name": "Respond - Booked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        560,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"completed\", \"appointment_id\": $json.appointment_id, \"calendar_event_id\": $json.calendar_event_id } }}"
      }
    },
    {
      "id": "respond-no-match",
      "name": "Respond - No Property Match",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        -160,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"no_match\", \"call_id\": $json.call_id } }}"
      }
    }
  ],
  "connections": {
    "Incoming Call Webhook": {
      "main": [
        [
          {
            "node": "Intent Classification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Intent Classification": {
      "main": [
        [
          {
            "node": "Property Match",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Property Match": {
      "main": [
        [
          {
            "node": "Property Match Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Property Match Found?": {
      "main": [
        [
          {
            "node": "Google Calendar - Book Visit",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond - No Property Match",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Calendar - Book Visit": {
      "main": [
        [
          {
            "node": "Gmail - Notify Employee",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Notify Employee": {
      "main": [
        [
          {
            "node": "Postgres - CRM Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - CRM Update": {
      "main": [
        [
          {
            "node": "Respond - Booked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "VOICE_AGENT_ERROR_HANDLER_WORKFLOW_ID"
  },
  "pinData": {},
  "versionId": "00000000-0000-0000-0000-000000000001",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "voice-agent"
    },
    {
      "name": "real-estate"
    },
    {
      "name": "capstone-week4-day4"
    }
  ]
}